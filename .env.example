# Copy this file to .env and fill in your own values. Never commit .env.

# The chat model (see setup_free_llm.md). OpenRouter shown; Ollama, Groq and Gemini also work.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# The database (midstone 2). PostgreSQL later: postgresql+psycopg://user:password@host/kaveri
DATABASE_URL=sqlite:///kaveri.db

# Web search for the agent (midstone 7)
SERPAPI_API_KEY=

# Tracing (midstone 8)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
